#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

PYTHON="${PYTHON:-python3}"

if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "error: python3 not found. Install Python 3.9+ and try again." >&2
  exit 1
fi

echo "=== Step 1/2: Sync Facebook posts ==="
"$PYTHON" "$ROOT_DIR/scripts/sync_facebook_posts.py" "$@"

echo ""
echo "=== Step 2/2: Process apartments ==="
"$PYTHON" "$ROOT_DIR/scripts/process_apartments.py" "$@"

echo ""
echo "=== Pipeline complete ==="
