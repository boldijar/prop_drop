{
  "entity": {
    "id": "apartments",
    "label": "Apartamente"
  },
  "storage": {
    "sourceKey": "prodrop:posts",
    "targetKey": "prodrop:apartments"
  },
  "processing": {
    "batchSize": 5,
    "geminiModel": "gemini-3.6-flash"
  },
  "geminiInputFields": [
    { "name": "title", "sources": ["title", "groupTitle"] },
    { "name": "description", "sources": ["description", "text"] },
    { "name": "text", "sources": ["text"] }
  ],
  "passthroughFields": [
    { "name": "postUrl", "sources": ["url"] },
    { "name": "postedAt", "sources": ["time"] },
    { "name": "postText", "sources": ["text"], "exact": true },
    {
      "name": "images",
      "sources": ["images", "media", "attachments"],
      "mergeArrays": true
    },
    { "name": "sourceGroupUrl", "sources": ["_groupUrl", "facebookUrl"] }
  ],
  "metadataFields": ["postId", "processedAt"],
  "extraction": {
    "intro": "Ești un extractor de date imobiliare din anunțuri Facebook din București.\n\nPrimești o listă de postări (doar titlu, descriere și text). Pentru FIECARE postare, extrage informațiile imobiliare disponibile.",
    "rules": [
      "Toate câmpurile pot fi null dacă informația nu reiese din text.",
      "Nu inventa date care nu sunt în text.",
      "esteAnuntReal: true doar dacă postarea este un anunț real de vânzare apartament; false dacă nu este (întrebări, discuții, închirieri, spam etc.).",
      "Dacă esteAnuntReal este false, celelalte câmpuri imobiliare pot fi null.",
      "Returnează EXACT un obiect JSON per postare, în aceeași ordine ca inputul.",
      "Răspunsul trebuie să fie un JSON array valid, fără markdown, fără text suplimentar."
    ],
    "schema": {
      "esteAnuntReal": "boolean | null",
      "pretEuro": "int | null",
      "comision": "float | null",
      "tipVanzator": "\"proprietar\" | \"agentie\" | \"dezvoltator\" | null",
      "zona": "string | null",
      "inApropiere": "string | null",
      "metrouInApropiere": "string | null",
      "esteFerentariSauRahova": "boolean | null",
      "numarCamere": "int | null",
      "suprafata": "int | null",
      "suprafataUtila": "int | null",
      "areBalcon": "boolean | null",
      "suprafataBalcon": "int | null",
      "etaj": "string | null",
      "anulConstructiei": "int | null",
      "incalzire": "\"centrala_pe_bloc\" | \"centrala_individuala\" | null",
      "incalzireInPardoseala": "boolean | null",
      "trebuieRenovat": "boolean | null",
      "inConstructie": "boolean | null",
      "locDeParcare": "\"da_inclus\" | \"da_contracost\" | \"nu\" | null",
      "numarTelefon": "string | null"
    },
    "footer": "POSTĂRI DE PROCESAT:"
  },
  "telegram": {
    "priceField": "pretEuro",
    "areaField": "suprafata"
  }
}
